# ─────────────────────────────────────────────────────────────────────────────
#  Qatar Camel Festival — ticketing (Laravel 12)
#  Copy to .env, then: php artisan key:generate
#  Never commit real secrets. Values marked [SECRET] belong only in .env or in
#  the encrypted admin settings (Settings → Payments / Messaging).
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME="مهرجان قطر للإبل"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tickets.example.qa
APP_VERSION=1.0.0
# Business clock: every date rule (cut-offs, reports, analytics) runs in Qatar time.
APP_BUSINESS_TIMEZONE=Asia/Qatar

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Comma-separated proxy IPs/CIDRs in front of the app ("*" only behind a trusted load balancer).
TRUSTED_PROXIES=*

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ── Database (MySQL 8 in production; SQLite works for local development) ─────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=qcamelmc
DB_USERNAME=qcamelmc
DB_PASSWORD=                         # [SECRET]
# SQLite only: DB_BUSY_TIMEOUT=10000  DB_JOURNAL_MODE=wal  DB_SYNCHRONOUS=normal

# ── Sessions, cache, queues (Redis recommended) ──────────────────────────────
SESSION_DRIVER=database              # database is required for "sign out everywhere"
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null                  # [SECRET]
REDIS_PORT=6379

# Spatie settings cache (flushed automatically on every settings save).
SETTINGS_CACHE_ENABLED=true

# ── Realtime (Laravel Reverb) ────────────────────────────────────────────────
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=qcamelmc
REVERB_APP_KEY=                      # [SECRET] php artisan reverb:install generates these
REVERB_APP_SECRET=                   # [SECRET]
REVERB_HOST=tickets.example.qa
REVERB_PORT=443
REVERB_SCHEME=https
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ── Mail (transactional invoices, payment-failed notices, security alerts) ───
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null                   # [SECRET]
MAIL_FROM_ADDRESS="tickets@example.qa"
MAIL_FROM_NAME="${APP_NAME}"
# Provider delivery webhooks POST to /webhooks/mail/{provider}; this signs them.
MAIL_WEBHOOK_SECRET=                 # [SECRET]

# ── First owner account (seeded once by `php artisan db:seed`) ───────────────
SEED_ADMIN_NAME="مالك النظام"
SEED_ADMIN_EMAIL=owner@example.qa
SEED_ADMIN_PASSWORD=                 # [SECRET] at least 12 characters; change after first sign-in
# Require two-factor authentication for admin accounts (keep true in production).
ADMIN_2FA_REQUIRED=true

# ── Team passcode for kiosks (POS / scanner devices) ─────────────────────────
# Prefer the hash: php artisan tinker --execute="echo Hash::make('your-passcode');"
STAFF_PASSCODE_HASH=                 # [SECRET] bcrypt/argon2 hash
# Legacy plain value (used only when no hash is set). Min 8 characters.
STAFF_PASSCODE=                      # [SECRET]

# ── Sadad Web Checkout 2.1 (fallbacks — normally set in Settings → Payments) ─
SADAD_MERCHANT_ID=
SADAD_WEBSITE_DOMAIN=                # exactly as registered in the Sadad panel, no https://
SADAD_CHECKOUT_SECRET=               # [SECRET]
SADAD_API_LOGIN_SECRET=              # [SECRET] optional; defaults to the checkout secret
SADAD_ENV=auto                       # auto | sandbox | live
SADAD_HTTP_TIMEOUT=8
# SADAD_API_LIVE_URL=https://api-s.sadad.qa
# SADAD_API_SANDBOX_URL=https://api-sandbox.sadad.qa
# Where customers return after paying when no booking origin is known.
FRONTEND_URL="${APP_URL}"
PAYMENT_HOLD_MINUTES=30
PAYMENT_MIN_ONLINE_AMOUNT=3.00

# ── Automation (n8n: WhatsApp invoices, e-mail relay) — fallbacks for Settings ─
N8N_WEBHOOK_URL=                     # [SECRET]
N8N_EMAIL_WEBHOOK_URL=               # [SECRET]
N8N_RESPONSE_SECRET=                 # [SECRET] signs n8n → /webhooks/n8n/response callbacks
N8N_HTTP_TIMEOUT=8
WHATSAPP_DRIVER=n8n                  # n8n | cloud

# ── Ticket QR codes ──────────────────────────────────────────────────────────
QR_DISK=qr
QR_SIZE=800
QR_MARGIN=2
QR_ECC=M
QR_HMAC_ENABLED=false
QR_HMAC_KEY=                         # [SECRET] when QR_HMAC_ENABLED=true

# ── Receipt OCR (vision model for card-slip reading) ─────────────────────────
AI_PROVIDER=gemini                   # gemini | openai (any OpenAI-compatible endpoint)
AI_MODEL=gemini-2.5-flash
AI_API_KEY=                          # [SECRET]
# AI_BASE_URL=https://api.openai.com/v1   (openai provider only)

# ── Visitor analytics ────────────────────────────────────────────────────────
# Optional MaxMind GeoLite2 City database for country/city (no third-party calls).
GEOIP_DATABASE=storage/app/geoip/GeoLite2-City.mmdb

# ── AI assistant (MCP) & API docs ────────────────────────────────────────────
MCP_ENABLED=true
MCP_TOKEN_DAYS=90
API_VERSION=1.0.0
SCRAMBLE_DEV_TOOLS=false
SANCTUM_STATEFUL_DOMAINS=tickets.example.qa

# ── One-off data migration from the old Supabase project (migrate:from-supabase) ─
# Either the Supabase HTTP API (php artisan migrate:from-supabase --source=rest) …
LEGACY_SUPABASE_URL=                 # https://<project-ref>.supabase.co
LEGACY_SUPABASE_SECRET_KEY=          # [SECRET] secret / service_role key — never the publishable key
# … or a direct, READ-ONLY Postgres copy of production (default --source=db). Remove after the cut-over.
LEGACY_DB_HOST=
LEGACY_DB_PORT=5432
LEGACY_DB_DATABASE=postgres
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=                  # [SECRET]
LEGACY_DB_SSLMODE=require

# ── Backups ──────────────────────────────────────────────────────────────────
BACKUP_DISK_DRIVER=local

# ── File storage ─────────────────────────────────────────────────────────────
# local = server disk (VPS/Docker with a volume). s3 = S3-compatible buckets — REQUIRED on
# Laravel Cloud and any host without a persistent disk (QR codes, images, receipts).
STORAGE_DRIVER=local
# Public bucket: QR codes, branding, uploads (AWS_URL = its public base URL)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=               # [SECRET]
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
# Private bucket: receipt photos, exports (falls back to the AWS_* values above)
AWS_PRIVATE_ACCESS_KEY_ID=
AWS_PRIVATE_SECRET_ACCESS_KEY=       # [SECRET]
AWS_PRIVATE_BUCKET=
AWS_PRIVATE_ENDPOINT=

VITE_APP_NAME="${APP_NAME}"

# ── Serverless hosting (Vercel) — see docs/DEPLOY-VERCEL.md ─────────────────────
# SERVERLESS=1 processes the Sadad webhook inline (no resident worker). The per-minute
# cron request GET /vercel/cron/minute (bearer CRON_SECRET) runs the scheduler and drains
# the database queue for CRON_BUDGET_SECONDS (keep below the function timeout).
SERVERLESS=false
CRON_SECRET=                         # [SECRET] random, 32+ chars
CRON_BUDGET_SECONDS=45
