<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Tests never touch the development database. -->
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="DB_JOURNAL_MODE" value="memory" force="true"/>
        <env name="APP_URL" value="https://qcamel.test" force="true"/>
        <env name="APP_LOCALE" value="ar"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="STAFF_PASSCODE" value="Gate-Pass-2026" force="true"/>
        <env name="STAFF_PASSCODE_HASH" value="" force="true"/>
        <env name="ADMIN_2FA_REQUIRED" value="false" force="true"/>
        <env name="SEED_ADMIN_EMAIL" value="" force="true"/>
        <env name="SEED_ADMIN_PASSWORD" value="" force="true"/>
        <env name="SETTINGS_CACHE_ENABLED" value="false" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
