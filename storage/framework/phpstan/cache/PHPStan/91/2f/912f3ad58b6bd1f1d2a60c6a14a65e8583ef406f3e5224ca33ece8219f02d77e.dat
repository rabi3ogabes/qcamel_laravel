 * Internal cache for styles
 * Used when applying style on range of cells (column or row) and cleared when
 * all cells in range is styled.
 *
 * PhpSpreadsheet will always minimize the amount of styles used. So cells with
 * same styles will reference the same Style instance. To check if two styles
 * are similar Style::getHashCode() is used. This call is expensive. To minimize
 * the need to call this method we can cache the internal PHP object id of the
 * Style in the range. Style::getHashCode() will then only be called when we
 * encounter a unique style.
 *
 * @see Style::applyFromArray()
 * @see Style::getHashCode()
 *
 * @var null|array<string, mixed[]>
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:75;s:7:"endLine";i:75;s:11:"startColumn";i:5;s:9:"endColumn";i:47;s:10:"isPromoted";b:0;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}}s:16:"immediateMethods";a:23:{s:11:"__construct";a:20:{s:4:"name";s:11:"__construct";s:10:"parameters";a:2:{s:12:"isSupervisor";a:13:{s:4:"name";s:12:"isSupervisor";s:7:"default";a:2:{s:4:"code";s:5:"false";s:10:"attributes";a:6:{s:9:"startLine";i:87;s:7:"endLine";i:87;s:13:"startTokenPos";i:174;s:12:"startFilePos";i:2432;s:11:"endTokenPos";i:174;s:10:"endFilePos";i:2436;}}s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:4:"bool";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:87;s:7:"endLine";i:87;s:11:"startColumn";i:33;s:9:"endColumn";i:58;s:14:"parameterIndex";i:0;s:10:"isOptional";b:1;}s:13:"isConditional";a:13:{s:4:"name";s:13:"isConditional";s:7:"default";a:2:{s:4:"code";s:5:"false";s:10:"attributes";a:6:{s:9:"startLine";i:87;s:7:"endLine";i:87;s:13:"startTokenPos";i:183;s:12:"startFilePos";i:2461;s:11:"endTokenPos";i:183;s:10:"endFilePos";i:2465;}}s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:4:"bool";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:87;s:7:"endLine";i:87;s:11:"startColumn";i:61;s:9:"endColumn";i:87;s:14:"parameterIndex";i:1;s:10:"isOptional";b:1;}}s:16:"returnsReference";b:0;s:10:"returnType";N;s:10:"attributes";a:0:{}s:10:"docComment";s:395:"/**
