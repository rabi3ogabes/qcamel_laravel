 * Instances of this class provide a reader for the GeoIP database format.
 * IP addresses can be looked up using the database specific methods.
 *
 * ## Usage ##
 *
 * The basic API for this class is the same for every database. First, you
 * create a reader object, specifying a file name. You then call the method
 * corresponding to the specific database, passing it the IP address you want
 * to look up.
 *
 * If the request succeeds, the method call will return a model class for
 * the method you called. This model in turn contains multiple record classes,
 * each of which represents part of the data returned by the database. If
 * the database does not contain the requested information, the attributes
 * on the record class will have a `null` value.
 *
 * If the address is not in the database, an
 * {@link \GeoIp2\Exception\AddressNotFoundException} exception will be
 * thrown. If an invalid IP address is passed to one of the methods, a
 * SPL {@link \InvalidArgumentException} will be thrown. If the database is
 * corrupt or invalid, a {@link \MaxMind\Db\Reader\InvalidDatabaseException}
 * will be thrown.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:46;s:7:"endLine";i:292;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:1:{i:0;s:24:"GeoIp2\ProviderInterface";}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:0:{}s:19:"immediateProperties";a:3:{s:8:"dbReader";a:16:{s:18:"declaringClassName";s:22:"GeoIp2\Database\Reader";s:21:"implementingClassName";s:22:"GeoIp2\Database\Reader";s:4:"name";s:8:"dbReader";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:17:"MaxMind\Db\Reader";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:48;s:7:"endLine";i:48;s:11:"startColumn";i:5;s:9:"endColumn";i:40;s:10:"isPromoted";b:0;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}s:6:"dbType";a:16:{s:18:"declaringClassName";s:22:"GeoIp2\Database\Reader";s:21:"implementingClassName";s:22:"GeoIp2\Database\Reader";s:4:"name";s:6:"dbType";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:49;s:7:"endLine";i:49;s:11:"startColumn";i:5;s:9:"endColumn";i:36;s:10:"isPromoted";b:0;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}s:7:"locales";a:16:{s:18:"declaringClassName";s:22:"GeoIp2\Database\Reader";s:21:"implementingClassName";s:22:"GeoIp2\Database\Reader";s:4:"name";s:7:"locales";s:9:"modifiers";i:2177;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"array";s:12:"isIdentifier";b:1;}}s:7:"default";a:2:{s:4:"code";s:6:"['en']";s:10:"attributes";a:6:{s:9:"startLine";i:63;s:7:"endLine";i:63;s:13:"startTokenPos";i:145;s:12:"startFilePos";i:225