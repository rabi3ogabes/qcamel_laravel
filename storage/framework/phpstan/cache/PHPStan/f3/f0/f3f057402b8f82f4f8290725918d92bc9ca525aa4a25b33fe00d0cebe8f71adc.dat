unts are in QAR and times in Asia/Qatar.'";s:10:"attributes";a:6:{s:9:"startLine";i:18;s:7:"endLine";i:18;s:13:"startTokenPos";i:71;s:12:"startFilePos";i:519;s:11:"endTokenPos";i:71;s:10:"endFilePos";i:995;}}}}}s:9:"startLine";i:16;s:7:"endLine";i:28;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";s:18:"Laravel\Mcp\Server";s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:0:{}s:19:"immediateProperties";a:1:{s:5:"tools";a:16:{s:18:"declaringClassName";s:28:"App\Mcp\Servers\QcamelServer";s:21:"implementingClassName";s:28:"App\Mcp\Servers\QcamelServer";s:4:"name";s:5:"tools";s:9:"modifiers";i:2;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"array";s:12:"isIdentifier";b:1;}}s:7:"default";a:2:{s:4:"code";s:191:"[\App\Mcp\Tools\ListEvents::class, \App\Mcp\Tools\EventSalesSummary::class, \App\Mcp\Tools\FindBooking::class, \App\Mcp\Tools\SearchCustomers::class, \App\Mcp\Tools\ListPaymentReviews::class]";s:10:"attributes";a:6:{s:9:"startLine";i:21;s:7:"endLine";i:27;s:13:"startTokenPos";i:93;s:12:"startFilePos";i:1064;s:11:"endTokenPos";i:120;s:10:"endFilePos";i:1226;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:21;s:7:"endLine";i:27;s:11:"startColumn";i:5;s:9:"endColumn";i:6;s:10:"isPromoted";b:0;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}}s:16:"immediateMethods";a:0:{}s:10:"traitsData";a:4:{s:7:"aliases";a:0:{}s:9:"modifiers";a:0:{}s:11:"precedences";a:0:{}s:6:"hashes";a:0:{}}}}