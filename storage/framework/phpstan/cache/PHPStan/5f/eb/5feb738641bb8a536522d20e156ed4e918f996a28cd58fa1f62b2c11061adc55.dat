 */";s:10:"attributes";a:0:{}s:9:"startLine";i:22;s:7:"endLine";i:135;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:1:{s:6:"PROMPT";a:12:{s:18:"declaringClassName";s:38:"App\Domain\Receipts\ParseReceiptAction";s:21:"implementingClassName";s:38:"App\Domain\Receipts\ParseReceiptAction";s:4:"name";s:6:"PROMPT";s:9:"modifiers";i:1;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:599:"'You are an AI specialized in reading POS receipt images. Extract ONLY these fields and return ONLY a JSON object: ' . 'amount_qar (number), seq_number (string), card_number_masked (string), time (HH:MM:SS), auth_number (string). Rules: amount_qar is a number ' . 'without currency symbols (e.g. 1000 not "QAR 1000.00"); seq_number must match SEQ NO / SEQ NUMBER; card_number_masked keeps the masking ' . 'exactly (**** allowed); time is 24-hour HH:MM:SS; auth_number must match AUTH NO / AUTH NUMBER; missing or unreadable → null; do NOT guess; ' . 'no explanations; return ONLY the JSON object.'";s:10:"attributes";a:6:{s:9:"startLine";i:24;s:7:"endLine";i:28;s:13:"startTokenPos";i:73;s:12:"startFilePos";i:715;s:11:"endTokenPos";i:85;s:10:"endFilePos";i:1341;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:24;s:7:"endLine";i:28;s:11:"startColumn";i:5;s:9:"endColumn";i:57;}}s:19:"immediateProperties";a:0:{}s:16:"immediateMethods";a:3:{s:7:"extract";a:20:{s:4:"name";s:7:"extract";s:10:"parameters";a:2:{s:6:"binary";a:13:{s:4:"name";s:6:"binary";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:31;s:7:"endLine";i:31;s:11:"startColumn";i:29;s:9:"endColumn";i:42;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}s:4:"mime";a:13:{s:4:"name";s:4:"mime";s:7:"default